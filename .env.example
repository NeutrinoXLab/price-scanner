APP_NAME="Price Scanner"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8095

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Set true only after approval for this project and a reviewed canonical CSV feed.
LIBRIS_FEED_APPROVED=false
LIBRIS_FEED_URL=
CARTURESTI_FEED_APPROVED=false
CARTURESTI_FEED_URL=
EMAG_FEED_APPROVED=false
EMAG_FEED_URL=
SCANNER_INTERVAL_MINUTES=360
SCANNER_OCR_BINARY=
DB_QUEUE_RETRY_AFTER=360

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Configure only feeds for which ingestion is contractually permitted.
TWOPERFORMANT_FEED_URL=
TWOPERFORMANT_FEED_APPROVED=false
PROFITSHARE_FEED_URL=
PROFITSHARE_FEED_APPROVED=false
AWIN_FEED_URL=
AWIN_FEED_APPROVED=false
SCANNER_INTERVAL_MINUTES=360
SCANNER_STALE_AFTER_HOURS=24
