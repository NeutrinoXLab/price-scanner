APP_NAME="Price Scanner"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://scan.novelions.ro
APP_TIMEZONE=Europe/Bucharest
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning

# SQLite remains isolated from Novelion and Tender Scanner.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=scan.novelions.ro
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# No worker is required until an authorized feed is enabled.
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Enable only after contractual permission and adapter verification.
LIBRIS_FEED_APPROVED=false
LIBRIS_FEED_URL=
CARTURESTI_FEED_APPROVED=false
CARTURESTI_FEED_URL=
EMAG_FEED_APPROVED=false
EMAG_FEED_URL=
TWOPERFORMANT_FEED_APPROVED=false
TWOPERFORMANT_FEED_URL=
PROFITSHARE_FEED_APPROVED=false
PROFITSHARE_FEED_URL=
AWIN_FEED_APPROVED=false
AWIN_FEED_URL=

SCANNER_INTERVAL_MINUTES=360
SCANNER_STALE_AFTER_HOURS=24
SCANNER_OCR_BINARY=
VITE_APP_NAME="${APP_NAME}"
